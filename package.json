{
  "name": "diapason",
  "version": "0.0.1",
  "description": "Whistle into your mic, get MIDI out. Browser-based monophonic pitch-to-MIDI.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom --pool=vmThreads",
    "lint": "oxlint .",
    "dupes": "fallow dupes --mode semantic --near --baseline .fallow-dupes-baseline.json --fail-on-issues --fail-on-baseline-growth",
    "audit": "fallow audit --health-baseline .fallow-health-baseline.json --fail-on-baseline-growth",
    "metrics": "fallow health --report-only",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run dupes && npm run audit && npm run metrics && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fallow": "^3.34.1",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
