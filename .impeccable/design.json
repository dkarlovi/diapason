      "html": "<div class=\"ds-audition\"><span>Gentle fix<small>Applied · Previewing</small></span><button type=\"button\" aria-pressed=\"true\">Stop</button></div>",
      "css": ".ds-audition{display:flex;align-items:center;gap:8px;padding:8px;border:1px solid var(--color-warning);border-radius:4px;background:color-mix(in oklab,var(--color-warning) 8%,var(--color-card));font:.8125rem/1.5 system-ui,sans-serif}.ds-audition>span{flex:1;min-width:0;overflow-wrap:anywhere}.ds-audition small{display:block;color:var(--color-warning)}.ds-audition button{padding:3px 7px;border:1px solid var(--color-warning);border-radius:5px;color:var(--color-warning);background:transparent}.ds-audition button:focus-visible{outline:2px solid var(--color-warning);outline-offset:3px}"
    },
    {
      "name": "Note inspector",
      "kind": "custom",
      "refersTo": "active-category",
      "description": "Selected-note inspector: a darker one-line heading (identity, time, Play in context, Mute note) above property rows on the neutral surface. Steppers are bordered with the muted fill; the borderless Reset keeps its slot and appears only once edited. Phones dock it at the bottom of the roll with 44px targets.",
      "html": "<section class=\"ds-note\" aria-label=\"Note #3 C5\"><div class=\"ds-note-head\"><strong>#3 · C5</strong><span>1.00 s · 0.50 s</span><button type=\"button\" aria-label=\"Hear in context\">▶</button><button type=\"button\" aria-label=\"Mute note\" aria-pressed=\"false\">♪</button></div><div class=\"ds-note-row\"><i aria-hidden=\"true\"></i><span>Pitch<span hidden>, edited</span></span><button type=\"button\" aria-label=\"Down one semitone\">−</button><output>C5</output><button type=\"button\" aria-label=\"Up one semitone\">+</button><button type=\"button\" class=\"ds-note-reset\" aria-label=\"Reset pitch\">↺</button></div></section>",
      "css": ".ds-note{width:max-content;border:1px solid var(--color-border);border-radius:6px;background:var(--color-card);font:.8125rem/1.5 system-ui,sans-serif;overflow:hidden}.ds-note-head{display:flex;align-items:center;gap:6px;padding:5px 6px 5px 12px;background:var(--color-muted);border-bottom:1px solid var(--color-border)}.ds-note-head span{margin-right:auto;color:var(--color-muted-foreground);font-variant-numeric:tabular-nums}.ds-note-head button{width:30px;height:30px;border:1px solid var(--color-border);border-radius:5px;background:var(--color-card)}.ds-note-head [aria-pressed=true]{color:var(--color-primary);border-color:var(--color-primary);background:var(--color-primary-muted)}.ds-note-row{display:grid;grid-template-columns:10px 64px 28px minmax(56px,1fr) 28px 28px;align-items:center;column-gap:4px;min-height:34px;padding:4px 10px}.ds-note-row i{width:10px;height:10px;border-radius:2px;background:repeating-linear-gradient(135deg,var(--color-primary) 0 2px,color-mix(in oklab,var(--color-primary) 40%,var(--color-card)) 2px 4px)}.ds-note-row button{width:28px;height:28px;border:1px solid var(--color-border);border-radius:5px;background:var(--color-muted)}.ds-note-row .ds-note-reset{border-color:transparent;background:transparent;color:var(--color-muted-foreground)}.ds-note-row output{text-align:center;font-weight:500}"
    }
  ],
  "narrative": {
    "northStar": "The canvas is the work",
    "overview": "Slate & blue, professional and restrained. Recording and editing are compact\nworkstations: the signal or melody owns the space, and controls support it.\nPreserve this established direction when refining or extending the interface.",
    "keyCharacteristics": [
      "Edge-to-edge work surfaces beneath one compact header.",
      "Shared controls and semantic color roles across Library, Recording, and Editor.",
      "System light/dark themes, with precise status and playback feedback."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Reuse the existing semantic tokens and `--trace-*` palette. Include text or state semantics alongside status colors.",
        "section": "colors"
      },
      {
        "name": "The One Heading Rule",
        "body": "Show the current screen or recording name once in the workstation breadcrumb. Do not repeat it as another workspace heading.",
        "section": "typography"
      },
      {
        "name": "The Canvas Space Rule",
        "body": "Controls must not push the signal or melody out of the viewport. Dense toolboxes scroll internally; work surfaces retain their space.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** preserve the canvas as the primary work surface.",
      "**Do** reuse semantic theme tokens, shared controls, and the pitch canvas.",
      "**Do** keep original audio and MIDI aligned in time.",
      "**Do** retain keyboard focus, accessible names, and reduced-motion behavior.",
      "**Do** preserve Record/Stop size and position through the folding transition."
    ],
    "donts": [
      "**Don't** duplicate the workstation name as a second heading.",
      "**Don't** introduce a separate visual system for recording and editing.",
      "**Don't** replace textual state feedback with color alone.",
      "**Don't** couple live capture's rendering loop to the editor's playback lifecycle."
    ]
  }
}
