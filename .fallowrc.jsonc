// The npm scripts still pass flags this format cannot express:
//   dupes/health  --baseline <file>        baseline files for whole-project runs
//   dupes/health  --fail-on-stale-baseline fail when a baseline entry matches no finding
//   dupes         --fail-on-issues
//   dupes         --fail-on-baseline-growth --baseline-base origin/main
//   audit         --base HEAD^
// TODO: restore `--fail-on-baseline-growth --baseline-base origin/main` on audit once the
// re-keyed health baseline (files moved into domain folders) is on main; the growth gate
// counts every moved path as a new finding.
{
  "entry": ["src/Recording/RecordingPackageReport.ts"],
  "framework": [
    {
      "name": "diapason-development-cli",
      "detection": {
        "type": "fileExists",
        "pattern": "tools/diapason.ts",
      },
      "entryPoints": ["tools/diapason.ts"],
      "entryPointRole": "support",
    },
  ],
  "duplicates": { "mode": "semantic", "near": true },
  "audit": { "healthBaseline": ".fallow-health-baseline.json" },
}
