{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "jsPlugins": ["./tools/oxlint/local-plugin.ts"],
  "options": {
    "typeAware": true,
    "typeCheck": false
  },
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/consistent-return": "off",
    "react/react-in-jsx-scope": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-add-event-listener": "off",
    "eslint/no-underscore-dangle": ["error", { "allow": ["__APP_BUILD__"] }],
    "typescript/no-floating-promises": "error",
    "react/rules-of-hooks": "error",
    "react/no-unknown-property": "error",
    "react/checked-requires-onchange-or-readonly": "error",
    "react/no-unstable-nested-components": "error",
    "react/style-prop-object": "error",
    "react/capitalized-calls": "error",
    "react/unsupported-syntax": "error",
    "local/no-narrative-comments": "error",
    "local/no-preset-special-casing": [
      "error",
      {
        "presetIds": [
          "as-played",
          "gentle",
          "clean",
          "keep-odd",
          "auto-tune",
          "happy",
          "sad",
          "dreamy",
          "syncopated",
          "auto-pitch",
          "auto-timing",
          "auto-major",
          "auto-minor",
          "auto-syncopated"
        ],
        "registries": ["src/Melody/Knobs.ts", "src/Tune/TuneFields.ts"],
        "tables": ["PRESETS"]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/Analysis/Analysis.worker.ts",
        "src/Audio/ClapInput.ts",
        "src/Audio/Recorder.ts",
        "src/Storage/StoredChanges.ts",
        "src/Storage/StoredChanges.test.ts"
      ],
      "rules": { "unicorn/require-post-message-target-origin": "off" }
    },
    {
      "files": ["src/Analysis/AnalysisJobs.test.ts", "src/Playback/Playback.test.ts"],
      "rules": { "typescript/no-extraneous-class": ["error", { "allowConstructorOnly": true }] }
    },
    {
      "files": ["src/Features/Editor/PreviewOption.tsx"],
      "rules": { "react/hooks": "off" }
    },
    {
      "files": ["tests/support/broadcast-channel.ts"],
      "rules": { "unicorn/require-module-specifiers": "off" }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "tests/**"],
      "rules": { "local/no-preset-special-casing": "off" }
    }
  ]
}
